<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <title>Câu 5 - Kiểm tra số nguyên tố</title>
</head>

<body>
    <h2>Câu 5: Kiểm tra số nguyên tố </h2>
    <script>
        var n = parseInt(prompt("Nhập vào một số nguyên dương:"));

        function kiemTraSNT(x) {
            if (isNaN(x) || x < 2) return false;
            for (var i = 2; i <= Math.sqrt(x); i++) {
                if (x % i === 0) return false;
            }
            return true;
        }

        if (kiemTraSNT(n)) {
            alert(n + " là số nguyên tố.");
        } else {
            alert(n + " không phải là số nguyên tố.");
        }
    </script>
</body>

</html>